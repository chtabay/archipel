{
  "manifest_version": 3,
  "name": "Le chemin",
  "short_name": "Chemin",
  "version": "0.1.0",
  "description": "Ce que tu écris dans la journée fait pousser un chemin à l’aquarelle, d’un clic sur son icône. Rien ne part de cet ordinateur.",
  "icons": {
    "16": "icones/favicon-16.png",
    "32": "icones/favicon-32.png",
    "96": "icones/symbole-96.png",
    "128": "icones/icone-128.png",
    "192": "icones/icone-192.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "fond.js",
    "scripts": [
      "fond.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "Le chemin",
    "default_icon": {
      "16": "icones/favicon-16.png",
      "32": "icones/favicon-32.png"
    }
  },
  "options_ui": {
    "page": "accord.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "chemin/index.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chemin@chtabay.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://chtabay.github.io/archipel/chemin/extension/updates.json"
    }
  }
}

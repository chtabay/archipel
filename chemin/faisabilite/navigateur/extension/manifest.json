{
  "manifest_version": 3,
  "name": "Le chemin, glaneur (prototype)",
  "short_name": "Glaneur",
  "version": "0.1.0",
  "description": "Prototype de faisabilité : ce qu’on écrit soi-même dans les pages fait pousser le chemin, sur cet ordinateur. Rien ne part.",
  "permissions": ["storage"],
  "incognito": "not_allowed",
  "background": { "service_worker": "fond.js", "scripts": ["fond.js"] },
  "action": { "default_title": "Le chemin : glaneur" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["glaneur.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["https://chtabay.github.io/archipel/chemin/*"],
      "js": ["pont.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "default-src 'self'; connect-src 'none'; object-src 'none'" },
  "browser_specific_settings": {
    "gecko": {
      "id": "glaneur@chemin.invalid",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
